###############################################
# HomeCyp — Production .env for cPanel
# Rename this file to ".env" and fill in your values.
###############################################

APP_NAME=HomeCyp
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://yourdomain.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# ---- Initial admin (required before first production seed) ----
ADMIN_NAME="HomeCyp Admin"
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=choose_a_unique_strong_password

# IMPORTANT for cPanel: file-based session & cache work without a DB table,
# so the web installer at /install runs before migrations exist.
SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync

LOG_CHANNEL=stack
LOG_LEVEL=error

# ---- Database (from cPanel → MySQL Databases) ----
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=your_cpanel_db
DB_USERNAME=your_cpanel_db_user
DB_PASSWORD=your_db_password

# ---- Mail (from cPanel → Email Accounts) ----
MAIL_MAILER=smtp
MAIL_HOST=mail.yourdomain.com
MAIL_PORT=465
MAIL_USERNAME=info@yourdomain.com
MAIL_PASSWORD=your_email_password
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=info@yourdomain.com
MAIL_FROM_NAME="${APP_NAME}"

# ---- Filesystem ----
FILESYSTEM_DISK=public

# ---- AI / LLM provider (swappable via admin panel → AI → LLM Settings too) ----
LLM_CHAT_PROVIDER=nvidia_nim
LLM_EMBEDDING_PROVIDER=nvidia_nim
LLM_CHAT_FALLBACKS=openai,anthropic
LLM_EMBEDDING_FALLBACKS=openai

NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_API_KEY=your_nvidia_nim_api_key
NVIDIA_NIM_CHAT_MODEL=meta/llama-3.1-70b-instruct
NVIDIA_NIM_EMBED_MODEL=nvidia/nemotron-3-embed-1b

# Optional fallback/alternative providers — only needed if you switch providers
# in the admin panel's LLM Settings page.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ---- Optional integrations ----
WHATSAPP_NUMBER=905338456497
CRM_WEBHOOK_URL=
CRM_WEBHOOK_TOKEN=
DOCUMENT_AI_URL=
DOCUMENT_AI_TOKEN=

# Generate APP_KEY locally with: php artisan key:generate --show
# then paste it above as APP_KEY=base64:....
